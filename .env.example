# ============================================
# NITJ Academic Resource Exchange System
# Environment Configuration
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nitj_resources?retryWrites=true&w=majority
# Local Docker Compose (docker compose up) — Compose overrides this to mongodb://mongo:27017/nitj_resources
MONGODB_URI=mongodb://localhost:27017/nitj_resources

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Short-lived access token (default 15m). JWT_EXPIRES_IN is accepted as a legacy alias.
JWT_ACCESS_EXPIRES_IN=15m
# Long-lived refresh token (rotated on each use)
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,ppt,pptx,doc,docx,txt,zip,rar,xlsx,xls,csv,png,jpg,jpeg
# Time-limited signed download URLs (HMAC/JWT TTL)
DOWNLOAD_SIGNED_URL_EXPIRES_IN=5m

# Admin Seed
ADMIN_EMAIL=admin@nitj.ac.in
ADMIN_PASSWORD=admin123

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173